{
  "name": "ucema-curso",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify:headings": "vitest run --config vitest.verify.config.ts verify/headings",
    "verify:numbers": "vitest run --config vitest.verify.config.ts verify/numbers",
    "verify:traceability": "vitest run --config vitest.verify.config.ts verify/traceability",
    "verify:bundle": "vitest run --config vitest.verify.config.ts verify/bundle",
    "verify": "vitest run --config vitest.verify.config.ts",
    "verify:strict": "cross-env VERIFY_STRICT=1 vitest run --config vitest.verify.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "katex": "^0.19.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.4",
    "@vue/test-utils": "^2.5.1",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  }
}
